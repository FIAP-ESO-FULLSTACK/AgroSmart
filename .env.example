# Copie este arquivo para .env e preencha. NUNCA versione o .env.

# Conta que o AgroSmart monitora (IMAP) e usa para responder (SMTP).
# No Gmail, use uma "senha de app" (requer verificação em 2 etapas):
# https://myaccount.google.com/apppasswords
EMAIL_USER=sua-conta@gmail.com
EMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# Para quem enviar os ALERTAS (infestação e plano de controle), além da
# resposta ao remetente do lote. Ex.: o agrônomo responsável pela área.
# Se ficar vazio, os alertas só vão na resposta ao remetente (um aviso
# aparece no log).
EMAIL_ALERTAS=agronomo@fazenda.com.br

# Servidores (os padrões servem para Gmail; mude apenas se usar outro provedor)
IMAP_HOST=imap.gmail.com
SMTP_HOST=smtp.gmail.com
